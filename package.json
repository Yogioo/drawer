{
	"name": "drawer",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "vite build",
		"dev": "vite --host",
		"preview": "vite preview",
		"test": "node --experimental-strip-types --test tests/*.test.ts",
		"test:security": "npm audit --audit-level=high",
		"desktop:dev": "tauri dev",
		"desktop:build": "tauri build",
		"desktop:build:debug": "tauri build --debug",
		"test:smoke": "node scripts/smoke-test.mjs",
		"test:installer": "node scripts/windows-installer-smoke.mjs",
		"test:release": "npx tsc -b --pretty false && npm run test && npm run test:security && npm run test:smoke && npm run test:installer"
	},
	"dependencies": {
		"@cloudflare/vite-plugin": "^1.29.1",
		"@excalidraw/excalidraw": "^0.18.1",
		"react": "^19.2.1",
		"react-dom": "^19.2.1",
		"wrangler": "^4.75.0"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20260831.1",
		"@tauri-apps/cli": "^2.11.4",
		"@types/node": "^24.0.0",
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.1",
		"typescript": "^5.8.3",
		"vite": "^8.0.16"
	},
	"overrides": {
		"lodash-es": "4.18.1",
		"nanoid": "3.3.18",
		"@excalidraw/mermaid-to-excalidraw": {
			"nanoid": "5.1.16"
		}
	}
}
